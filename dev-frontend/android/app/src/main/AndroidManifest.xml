<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ★ 2026-09-18 — 세션 토큰이 백업·기기이전으로 새지 않게 한다.
         앱은 원격 껍데기라 로그인 세션이 WebView 저장소(쿠키·localStorage)에 남는다.
         기본값(allowBackup="true")이면 그 세션이 사용자 Drive 로 백업되고 **다른 기기로 복원**된다.
         API 31+ 는 res/xml/data_extraction_rules.xml 이, 그 미만은 allowBackup 이 막는다 —
         둘 다 둬야 기기 세대에 따라 조용히 갈리지 않는다. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (딥링크) — 링크를 누르면 앱이 깔려 있으면 앱으로.
                 ★ 반드시 **경로를 좁혀서** 잡는다. host 만 적으면 그 도메인의 모든 링크를
                   앱이 가로채는데, PlanQ 는 고객·외부 파트너가 **로그인 없이 웹으로 봐야 하는**
                   표면(공유 문서·서명·공개 위키·랜딩)을 같은 도메인으로 낸다.
                 ★ host 는 **이 빌드가 보여 주는 서버 하나**다(server.url). 운영 앱이 dev.planq.kr 을 받으면
                   dev 링크를 눌렀는데 운영 데이터의 같은 경로가 열린다(2026-10-09).
                 아래 pq:app-links 사이는 손으로 고치지 않는다 — `node scripts/cap-link-domains.js` 가
                 scripts/native-link-paths.js(iOS AASA 와 같은 정본)와 server.url 로 다시 쓴다(cap:sync·cap:beta 에 물려 있다). -->
            <!-- pq:app-links:start -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="planq.kr" />
                <data android:path="/oauth/native-return" />
                <data android:pathPrefix="/inbox" />
                <data android:pathPrefix="/notifications" />
                <data android:pathPrefix="/dashboard" />
                <data android:pathPrefix="/home" />
                <data android:pathPrefix="/talk" />
                <data android:pathPrefix="/task" />
                <data android:pathPrefix="/projects" />
                <data android:pathPrefix="/docs" />
                <data android:pathPrefix="/notes" />
                <data android:pathPrefix="/calendar" />
                <data android:pathPrefix="/mail" />
                <data android:pathPrefix="/files" />
                <data android:pathPrefix="/info" />
                <data android:pathPrefix="/bills" />
                <data android:pathPrefix="/sale" />
                <data android:pathPrefix="/signatures" />
                <data android:pathPrefix="/attendance" />
                <data android:pathPrefix="/stats" />
                <data android:pathPrefix="/whats-new" />
                <data android:pathPrefix="/personal-vault" />
                <data android:pathPrefix="/business/" />
                <data android:pathPrefix="/settings" />
                <data android:pathPrefix="/profile" />
                <data android:pathPrefix="/me/" />
                <data android:pathPrefix="/admin" />
            </intent-filter>
            <!-- pq:app-links:end -->
            <!-- 다른 앱의 «공유» → PlanQ (#434). mimeType 은 웹 공유(public/manifest.json share_target.accept)와
                 **같은 목록**이다 — 한쪽만 늘리면 웹과 앱이 받는 파일이 갈라진다. 받은 뒤는 ShareReceivePlugin → /share-receive. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <!--
              custom scheme fallback — App Links(autoVerify) 는 assetlinks.json 서빙 후에만 발화한다.
              그 전에도, 그리고 서버 302 redirect 체인에서 App Links 가 안 먹는 경우에도
              planq:// 로 앱에 복귀할 수 있게 둔다. NativeBridge 의 appUrlOpen 이 양쪽 다 수신.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="planq" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 푸시 알림 권한 (M-6) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Q Note 마이크 녹음 (Phase 4 대비 — §8.1) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>

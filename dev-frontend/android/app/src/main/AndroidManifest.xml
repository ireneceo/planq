<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (딥링크) — planq.kr / dev.planq.kr 링크를 앱으로.
                 ★ 반드시 **경로를 좁혀서** 잡는다. host 만 적으면 그 도메인의 모든 링크를
                   앱이 가로채는데, PlanQ 는 고객·외부 파트너가 **로그인 없이 웹으로 봐야 하는**
                   표면(공유 문서·서명·공개 위키·랜딩)을 같은 도메인으로 낸다. 앱을 깐 사람이
                   그 링크를 받으면 브라우저 미리보기 대신 앱이 열려 "안 보인다" 가 된다.
                 iOS 의 AASA components 와 **같은 목록**이어야 한다 — 한쪽만 고치면 갈라진다.
                   현재 정본: /oauth/native-return · /inbox* · /talk* · /task* · /notifications*
                   (public/dev-frontend-build/.well-known/apple-app-site-association) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="planq.kr" />
                <data android:scheme="https" android:host="dev.planq.kr" />
                <data android:path="/oauth/native-return" />
                <data android:pathPrefix="/inbox" />
                <data android:pathPrefix="/talk" />
                <data android:pathPrefix="/task" />
                <data android:pathPrefix="/notifications" />
            </intent-filter>
            <!--
              custom scheme fallback — App Links(autoVerify) 는 assetlinks.json 서빙 후에만 발화한다.
              그 전에도, 그리고 서버 302 redirect 체인에서 App Links 가 안 먹는 경우에도
              planq:// 로 앱에 복귀할 수 있게 둔다. NativeBridge 의 appUrlOpen 이 양쪽 다 수신.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="planq" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 푸시 알림 권한 (M-6) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Q Note 마이크 녹음 (Phase 4 대비 — §8.1) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 본 앱(App/App.entitlements)과 같은 App Group — 확장이 받은 파일을 여기에 두고 본 앱이 가져간다.
	     두 파일의 값이 다르면 scripts/ios-beta-check.js 가 막는다. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.planq</string>
	</array>
</dict>
</plist>
